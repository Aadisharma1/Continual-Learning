# Template for API keys — copy this to .env and put your real keys there.
# .env is gitignored and is never committed.
#
# The runner (`python -m gates.runall`) reads this file first and only prompts
# for what is missing, once, then writes .env with mode 600. Secrets are never
# passed on argv, so they never appear in `ps` or shell history.

# HuggingFace token — REQUIRED for meta-llama/Meta-Llama-3.1-8B-Instruct (gated).
HF_TOKEN=

# Fine-grained GitHub PAT (repo scope). Only needs Contents: read+write on
# aadisharma1/Conti. Used transiently by the periodic artifact sync, then the
# runner scrubs it back out of the `origin` remote URL.
CONTI_GITHUB_TOKEN=

# Only needed when the config sets "wandb": true.
WANDB_API_KEY=
