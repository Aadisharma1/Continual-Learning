# --- G7/G8 gate pipeline ---
# Runner logs and per-run state are transient; artifacts under
# results/artifacts/ ARE tracked on purpose (periodic artifact sync).
outputs/
results/artifacts/
!results/artifacts/

# data/ is ignored above for training corpora, but the gate prompt sets are
# pre-registered inputs and must be versioned.
!data/
data/*
!data/prompts/
!data/prompts/*.jsonl
!data/prompts/MANIFEST.json

*.pt
*.safetensors
